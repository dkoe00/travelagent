# general
LLM_API_KEY=""
LLM_BASE_URL=""
LLM_MODEL="gpt-5-nano"
ENABLE_TRACING="false"
LANGUAGE="de"  # Supported: de (German), en (English)

# External search API (used by web_search tool). Get a free key at https://tavily.com.
TAVILY_API_KEY=""

# Google Places API (used by validate_place tool to confirm places and fetch opening hours).
# Requires a Google Cloud project with the "Places API (New)" enabled and billing set up
# (a free monthly credit typically covers seminar-scale usage).
GOOGLE_PLACES_API_KEY=""

# geocoding
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="travelagent-private-planner/0.1"
NOMINATIM_EMAIL=""
NOMINATIM_TIMEOUT_SECONDS="10"
OSRM_BASE_URL="https://router.project-osrm.org/route/v1"
OSRM_TIMEOUT_SECONDS="10"
